# للتشغيل المحلي: انسخ هذا الملف إلى .env
# للرفع على Render/Northflank: ضع هذه المتغيرات في لوحة إعدادات الخدمة (Secrets) — لا ترفع ملف .env

# رابط قاعدة بيانات PostgreSQL (Neon). املأه برابط قاعدة بياناتك الحقيقية.
DATABASE_URL="postgresql://user:password@host:5432/nibras?sslmode=require"

# مجلد الواجهة الجاهزة المرفوعة مع الكود
WEBROOT=public-build

# الخادم خلف بروكسي وسيط (منصة الرفع) — مطلوب للـ HTTPS وقراءة IP الصحيح
TRUST_PROXY=1

# فرض تحويل HTTP إلى HTTPS
FORCE_HTTPS=1

# منفذ التشغيل — محليًا 8090، وعلى المنصة يُضبط تلقائيًا
PORT=8090

# بريد استعادة الرقم السري (SMTP من Gmail) — كلمة مرور التطبيق من إعدادات Google
# (https://myaccount.google.com/apppasswords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=nassser8@gmail.com
MAIL_PASS=ضع-كلمة-مرور-التطبيق-هنا
MAIL_FROM=nassser8@gmail.com

# الرسائل الجماعية عبر WhatsApp Cloud API (اختياري).
# بدونها يبقى الإرسال الرسمي «غير مهيّأ» وتُستخدم طريقة الإرسال اليدوي (wa.me).
# المفتاح من: Meta for Developers > WhatsApp > API Setup (تطبيق أعمال).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# قالب معتمد (اختياري) — يُستخدم إن كان مطلوبًا خارج نافذة الـ 24 ساعة
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
# رمز تحقق الـ webhook (اختياري) لتحديث حالات التسليم تلقائيًا
WHATSAPP_VERIFY_TOKEN=
